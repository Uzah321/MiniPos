APP_NAME="ServeNest Back Office - {{SITE_NAME}}"
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL={{APP_ORIGIN}}
APP_ASSET_URL=
APP_TIMEZONE=Africa/Harare
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT={{DATABASE_PORT}}
DB_DATABASE={{DATABASE_NAME}}
DB_USERNAME={{DATABASE_USER}}
DB_PASSWORD="{{DATABASE_PASSWORD}}"
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
CACHE_PREFIX={{CACHE_PREFIX}}
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
CORS_ALLOWED_ORIGINS={{APP_ORIGIN}}

POS_LOGIN_CREDENTIAL_FAILURES_PER_MINUTE=10
POS_LOGIN_TERMINAL_FAILURES_PER_MINUTE=10
POS_LOGIN_NETWORK_FAILURES_PER_MINUTE=30
POS_LOGIN_MODE_REQUESTS_PER_MINUTE=120

SERVENEST_DEPLOYMENT_MODE=cloud
SERVENEST_SEED_SIMULATION_DATA=false
SERVENEST_SYNC_LOCAL_HUB=false
SERVENEST_SYNC_ALLOW_LEGACY_DOMAIN_RESOLUTION=false
SERVENEST_SYNC_NODE_CODE=CLOUD-HUB
SERVENEST_SYNC_NODE_NAME="{{SITE_NAME}}"

# Shared with every shop POS server through the shop connection file so
# synchronized login-code blind indexes resolve offline. Never rotate blindly.
AUTH_LOGIN_CODE_LOOKUP_KEY_ID={{LOGIN_CODE_LOOKUP_KEY_ID}}
AUTH_LOGIN_CODE_LOOKUP_KEY={{LOGIN_CODE_LOOKUP_KEY}}

# Central is the licence issuer. The private key never leaves this server;
# shops receive only the public key.
PLATFORM_ADMIN_POS_USER_IDS={{PLATFORM_ADMIN_IDS}}
LEGACY_PLATFORM_ADMIN_EMAILS=
LICENSE_WARNING_DAYS=90
LICENSE_SUPPORT_PHONE=
LICENSE_SIGNING_MODE=issuer
LICENSE_SIGNATURE_ALGORITHM={{LICENSE_ALGORITHM}}
LICENSE_SIGNATURE_KEY_ID={{LICENSE_KEY_ID}}
LICENSE_SIGNATURE_PRIVATE_KEY={{LICENSE_PRIVATE_KEY}}
LICENSE_SIGNATURE_PRIVATE_KEY_PASSPHRASE=
LICENSE_SIGNATURE_PUBLIC_KEY={{LICENSE_PUBLIC_KEY}}
LICENSE_SIGNATURE_PUBLIC_KEYS={{LICENSE_PUBLIC_KEYS}}
LICENSE_LEGACY_HMAC_VERIFY=false
LICENSE_LEGACY_HMAC_SIGN=false
LICENSE_LEGACY_HMAC_KEY=
LICENSE_LEGACY_APP_KEY_FALLBACK=false
LICENSE_ALLOW_UNSIGNED_LEGACY=false
LICENSE_AUTO_UPGRADE_UNSIGNED=false
LICENSE_LEGACY_OFFLINE_TOKEN_VERIFY=false

ZIMRA_ENVIRONMENT=production
ZIMRA_TEST_BASE_URL=https://fdmsapitest.zimra.co.zw
ZIMRA_PROD_BASE_URL=https://fdmsapi.zimra.co.zw
ZIMRA_TIMEOUT=30
ZIMRA_TEST_VERIFY_SSL=true
ZIMRA_PROD_VERIFY_SSL=true
ZIMRA_CERTIFICATE_BASE_PATH=storage/app/private/zimra/devices

SANCTUM_STATEFUL_DOMAINS={{STATEFUL_DOMAINS}}
SANCTUM_TOKEN_PREFIX=servenest_cloud_
MAIL_MAILER=log
