APP_NAME="ServeNest POS - {{SITE_NAME}}"
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL={{APP_ORIGIN}}
APP_ASSET_URL=
APP_TIMEZONE=Africa/Harare
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT={{DATABASE_PORT}}
DB_DATABASE={{DATABASE_NAME}}
DB_USERNAME={{DATABASE_USER}}
DB_PASSWORD="{{DATABASE_PASSWORD}}"
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
CACHE_PREFIX={{CACHE_PREFIX}}
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
CORS_ALLOWED_ORIGINS={{APP_ORIGIN}}

POS_LOGIN_CREDENTIAL_FAILURES_PER_MINUTE=10
POS_LOGIN_TERMINAL_FAILURES_PER_MINUTE=10
POS_LOGIN_NETWORK_FAILURES_PER_MINUTE=30
POS_LOGIN_MODE_REQUESTS_PER_MINUTE=120

SERVENEST_DEPLOYMENT_MODE=edge
SERVENEST_SEED_SIMULATION_DATA=false
SERVENEST_SYNC_CLOUD_URL={{BACK_OFFICE_URL}}
SERVENEST_SYNC_ALLOW_UNPINNED_CLOUD_URL=false
SERVENEST_SYNC_ALLOW_INSECURE_HTTP=false
SERVENEST_SYNC_VERIFY_TLS=true
SERVENEST_SYNC_CA_BUNDLE="{{SYNC_CA_BUNDLE}}"
SERVENEST_SYNC_ALLOW_LEGACY_DOMAIN_RESOLUTION=false
SERVENEST_SYNC_NODE_CODE=
SERVENEST_SYNC_NODE_NAME="{{SITE_NAME}} POS Server"
SERVENEST_SYNC_CONNECT_TIMEOUT_SECONDS=5
SERVENEST_SYNC_TIMEOUT_SECONDS=30
SERVENEST_SYNC_DAY_END_TIMEOUT_SECONDS=300
SERVENEST_SYNC_PUSH_INTERVAL_SECONDS=30
SERVENEST_SYNC_PULL_INTERVAL_SECONDS=30
SERVENEST_SYNC_HEARTBEAT_INTERVAL_SECONDS=60
SERVENEST_SYNC_STATUS_FRESH_SECONDS=180
SERVENEST_SYNC_RUN_LOCK_SECONDS=1800
SERVENEST_SYNC_PUSH_BATCH_SIZE=200
SERVENEST_SYNC_PULL_BATCH_SIZE=500
SERVENEST_SYNC_MAX_ATTEMPTS=20
SERVENEST_SYNC_RETRY_BACKOFF_SECONDS=5,15,30,60,300

# Must equal the Back Office key so synchronized login-code blind indexes
# resolve offline. Delivered through the Back Office shop connection file.
AUTH_LOGIN_CODE_LOOKUP_KEY_ID={{LOGIN_CODE_LOOKUP_KEY_ID}}
AUTH_LOGIN_CODE_LOOKUP_KEY={{LOGIN_CODE_LOOKUP_KEY}}

PLATFORM_ADMIN_POS_USER_IDS=
LEGACY_PLATFORM_ADMIN_EMAILS=
LICENSE_WARNING_DAYS=90
LICENSE_SUPPORT_PHONE=
LICENSE_SIGNING_MODE=verify_only
LICENSE_SIGNATURE_ALGORITHM={{LICENSE_ALGORITHM}}
LICENSE_SIGNATURE_KEY_ID={{LICENSE_KEY_ID}}
LICENSE_SIGNATURE_PRIVATE_KEY=
LICENSE_SIGNATURE_PRIVATE_KEY_PASSPHRASE=
LICENSE_SIGNATURE_PUBLIC_KEY={{LICENSE_PUBLIC_KEY}}
LICENSE_SIGNATURE_PUBLIC_KEYS={{LICENSE_PUBLIC_KEYS}}
LICENSE_LEGACY_HMAC_VERIFY=false
LICENSE_LEGACY_HMAC_SIGN=false
LICENSE_LEGACY_HMAC_KEY=
LICENSE_LEGACY_APP_KEY_FALLBACK=false
LICENSE_ALLOW_UNSIGNED_LEGACY=false
LICENSE_AUTO_UPGRADE_UNSIGNED=false
LICENSE_LEGACY_OFFLINE_TOKEN_VERIFY=false

ZIMRA_ENVIRONMENT=production
ZIMRA_TEST_BASE_URL=https://fdmsapitest.zimra.co.zw
ZIMRA_PROD_BASE_URL=https://fdmsapi.zimra.co.zw
ZIMRA_TIMEOUT=30
ZIMRA_TEST_VERIFY_SSL=true
ZIMRA_PROD_VERIFY_SSL=true
ZIMRA_CERTIFICATE_BASE_PATH=storage/app/private/zimra/devices

SANCTUM_STATEFUL_DOMAINS={{STATEFUL_DOMAINS}}
SANCTUM_TOKEN_PREFIX=servenest_edge_
MAIL_MAILER=log
