# Leave blank when Nginx serves the SPA and `/api` from the same origin.
# A LAN terminal may instead use the shop POS origin, for example
# http://192.168.1.10:8083. Do not append `/api`.
# public/runtime-config.js is preferred for per-installation overrides.
REACT_APP_API_BASE_URL=

# Hospitality workspace profile for this installation:
# - front-office: physical POS only (requires local node pairing when supported)
# - back-office: central/cloud management only
# Build each deployment separately. Use front-office for the shop edge build
# and back-office for the central cloud build. No workspace chooser is included.
REACT_APP_DEPLOYMENT_MODE=back-office

# API/database role for a dedicated installation: edge, standalone or cloud.
# public/runtime-config.js can override this without rebuilding the bundle.
REACT_APP_BACKEND_MODE=

# Shop POS automatic sync heartbeat. Values below 15000 use the safe
# 60000 ms default. This can also be changed per install in runtime-config.js.
REACT_APP_SYNC_INTERVAL_MS=60000

# Default-off escape hatch for a pre-sync local API. Never enable this on a
# distributed Front Office installation because it bypasses device pairing.
REACT_APP_ALLOW_LEGACY_SYNC_CONTRACT=false
