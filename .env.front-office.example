# ServeNest shop edge POS. Serve the UI and local API from the same edge host;
# remote LAN terminals use that POS server's host/port in runtime-config.js.
REACT_APP_API_BASE_URL=http://127.0.0.1:8003
REACT_APP_DEPLOYMENT_MODE=front-office
REACT_APP_BACKEND_MODE=edge
REACT_APP_SYNC_INTERVAL_MS=60000
REACT_APP_ALLOW_LEGACY_SYNC_CONTRACT=false
