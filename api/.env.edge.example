# Overlay for the database-owning ServeNest shop POS server. LAN browser
# terminals use this server; they do not run another database or sync worker.
APP_NAME="ServeNest Shop Edge"
APP_ENV=production
APP_DEBUG=false
# Set true only for a local branch simulation while running DatabaseSeeder.
SERVENEST_SEED_SIMULATION_DATA=false
# Local XAMPP edge project: C:\xampp\htdocs\ServeNestApi\api
# `php artisan serve --host=127.0.0.1 --port=8003` serves this URL without
# changing the machine's existing Nginx configuration.
APP_URL=http://127.0.0.1:8003
CORS_ALLOWED_ORIGINS=http://localhost:8083,http://127.0.0.1:8083,http://localhost:3000,http://127.0.0.1:3000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=ServeNest
DB_USERNAME=root
DB_PASSWORD=

SERVENEST_DEPLOYMENT_MODE=edge
SERVENEST_SYNC_CLOUD_URL=http://127.0.0.1:8002
SERVENEST_SYNC_NODE_CODE=
SERVENEST_SYNC_NODE_NAME="ServeNest Shop Edge"
SERVENEST_SYNC_ALLOW_UNPINNED_CLOUD_URL=false
SERVENEST_SYNC_ALLOW_INSECURE_HTTP=true
SERVENEST_SYNC_VERIFY_TLS=false

# Must match the cloud key id/value and must be delivered through the secure
# deployment channel. Never place it in a frontend build or sync payload.
AUTH_LOGIN_CODE_LOOKUP_KEY_ID=v1
AUTH_LOGIN_CODE_LOOKUP_KEY=

LICENSE_SIGNING_MODE=verify_only
LICENSE_SIGNATURE_PRIVATE_KEY=
LICENSE_SIGNATURE_PUBLIC_KEY=
PLATFORM_ADMIN_POS_USER_IDS=

