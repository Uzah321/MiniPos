# Overlay for the central ServeNest cloud API. Start from .env.example, then
# apply these values and provision every blank secret outside source control.
APP_NAME="ServeNest Cloud"
APP_ENV=production
APP_DEBUG=false
# Set true only for the local cloud simulation while running DatabaseSeeder.
# Return it to false before treating the installation as production.
SERVENEST_SEED_SIMULATION_DATA=false
# Local cloud test copy: C:\ServeNestCloudApi\api
# `php artisan serve --host=127.0.0.1 --port=8002` serves this URL without
# changing the machine's existing Nginx configuration.
APP_URL=http://127.0.0.1:8002
CORS_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=ServeNestCloud
DB_USERNAME=root
DB_PASSWORD=

SERVENEST_DEPLOYMENT_MODE=cloud
SERVENEST_SYNC_NODE_CODE=CLOUD-HUB
SERVENEST_SYNC_NODE_NAME="ServeNest Cloud Hub"

# Generate one dedicated 32-byte value. Provision the exact same value and key
# id to authorized edge servers so synced blind indexes remain usable offline.
AUTH_LOGIN_CODE_LOOKUP_KEY_ID=v1
AUTH_LOGIN_CODE_LOOKUP_KEY=

LICENSE_SIGNING_MODE=issuer
LICENSE_SIGNATURE_PRIVATE_KEY=
LICENSE_SIGNATURE_PRIVATE_KEY_PASSPHRASE=
LICENSE_SIGNATURE_PUBLIC_KEY=
PLATFORM_ADMIN_POS_USER_IDS=

