APP_NAME=ServeNest
APP_ENV=local
APP_KEY=
AUTH_LOGIN_CODE_LOOKUP_KEY_ID=v1
# Required on cloud and POS edge backends. Generate one 32-byte secret and
# provision the same base64 value securely to every edge; do not reuse APP_KEY.
AUTH_LOGIN_CODE_LOOKUP_KEY=
# Keep the former key during a rotation until successful logins have
# re-indexed all users with the active key.
AUTH_LOGIN_CODE_LOOKUP_PREVIOUS_KEY_ID=
AUTH_LOGIN_CODE_LOOKUP_PREVIOUS_KEY=
APP_DEBUG=true
APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8082,http://127.0.0.1:8082,http://localhost:8083,http://127.0.0.1:8083

# Local/test fixture only: creates Cashier1 with the documented simulation
# password and full company Super Admin access. Keep false in real deployments.
SERVENEST_SEED_SIMULATION_DATA=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=servenest
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Failed-login protection. Successful logins do not consume these limits and
# every company/terminal has an isolated bucket. Do not disable in production.
POS_LOGIN_CREDENTIAL_FAILURES_PER_MINUTE=10
POS_LOGIN_TERMINAL_FAILURES_PER_MINUTE=10
POS_LOGIN_NETWORK_FAILURES_PER_MINUTE=30
POS_LOGIN_MODE_REQUESTS_PER_MINUTE=120

# License reminder defaults. A company's License Support Phone overrides this number.
LICENSE_WARNING_DAYS=90
LICENSE_SUPPORT_PHONE=

# Central-issued standalone setup files expire if they are not imported within
# this window. The imported licence retains its own separately signed expiry.
SERVENEST_STANDALONE_PACKAGE_TTL_HOURS=168

# Global platform administrators must be explicitly trusted by immutable POS
# user UUID. A tenant Super Admin is not a platform administrator by default.
# Configure this only on cloud/standalone Back Office servers, never edges.
PLATFORM_ADMIN_POS_USER_IDS=

# License signing. Issuer nodes hold the private key; edge nodes must use
# verify_only and receive only the public key/keyring. PEM values may be stored
# as base64:<base64-of-the-PEM>. OpenSSL SHA-256 supports RSA and EC in XAMPP.
# Leave blank to default to issuer for cloud and verify_only for edge/standalone.
LICENSE_SIGNING_MODE=
LICENSE_SIGNATURE_ALGORITHM=openssl-sha256
LICENSE_SIGNATURE_KEY_ID=primary-2026
LICENSE_SIGNATURE_PRIVATE_KEY=
LICENSE_SIGNATURE_PRIVATE_KEY_PASSPHRASE=
LICENSE_SIGNATURE_PUBLIC_KEY=
LICENSE_SIGNATURE_PUBLIC_KEYS={}

# Transitional v1 compatibility. Keep these explicit while old entitlements
# are being re-signed, then disable them. Edge deployments should disable
# signing and unsigned upgrades immediately.
# Standalone/cloud defaults remain true for rollout compatibility; edge
# defaults are false. Uncomment only the compatibility paths you still need.
# LICENSE_LEGACY_HMAC_VERIFY=true
# LICENSE_LEGACY_HMAC_SIGN=true
LICENSE_LEGACY_HMAC_KEY=
# LICENSE_LEGACY_APP_KEY_FALLBACK=true
# LICENSE_ALLOW_UNSIGNED_LEGACY=true
# LICENSE_AUTO_UPGRADE_UNSIGNED=true
# LICENSE_LEGACY_OFFLINE_TOKEN_VERIFY=true

# The exact same codebase is deployed for cloud and branch POS. This is the
# canonical switch; retired environment names remain read-only fallbacks for
# installed systems and should not be used in a new ServeNest deployment.
# `standalone` disables synchronization. Use `cloud` for the shared hub or
# `edge` for a branch server. Cloud URLs should be HTTPS outside development.
#
# Cloud Back Office profile (copy this project to C:\ServeNestCloudApi):
#   SERVENEST_DEPLOYMENT_MODE=cloud
#   SERVENEST_SYNC_CLOUD_URL=
#   LICENSE_SIGNING_MODE=issuer
#
# XAMPP branch POS profile (a separate folder/database, same release artifact):
#   SERVENEST_DEPLOYMENT_MODE=edge
#   SERVENEST_SYNC_CLOUD_URL=https://central.example.com
#   LICENSE_SIGNING_MODE=verify_only
#   PLATFORM_ADMIN_POS_USER_IDS=
# Keep real APP_KEY, authentication lookup keys, signing keys and database
# credentials out of source control; never copy the cloud database to an edge.
SERVENEST_DEPLOYMENT_MODE=standalone
SERVENEST_DEFAULT_SALES_CHANNEL=POS
SERVENEST_CATALOG_SOURCE_SYSTEM=gaap
SERVENEST_SYNC_CLOUD_URL=
# Development/recovery only; keep false in production.
SERVENEST_SYNC_ALLOW_UNPINNED_CLOUD_URL=false
SERVENEST_SYNC_ALLOW_INSECURE_HTTP=false
SERVENEST_SYNC_ALLOW_LEGACY_DOMAIN_RESOLUTION=false
SERVENEST_SYNC_NODE_CODE=
SERVENEST_SYNC_NODE_NAME="${APP_NAME}"
SERVENEST_SYNC_CONNECT_TIMEOUT_SECONDS=5
SERVENEST_SYNC_TIMEOUT_SECONDS=30
SERVENEST_SYNC_DAY_END_TIMEOUT_SECONDS=300
SERVENEST_SYNC_VERIFY_TLS=true
SERVENEST_SYNC_PUSH_INTERVAL_SECONDS=30
SERVENEST_SYNC_PULL_INTERVAL_SECONDS=30
SERVENEST_SYNC_HEARTBEAT_INTERVAL_SECONDS=60
SERVENEST_SYNC_STATUS_FRESH_SECONDS=180
SERVENEST_SYNC_PRESENCE_STALE_SECONDS=180
SERVENEST_SYNC_RUN_LOCK_SECONDS=1800
SERVENEST_SYNC_PUSH_BATCH_SIZE=200
SERVENEST_SYNC_PULL_BATCH_SIZE=500
SERVENEST_SYNC_ACTIVATION_TTL_MINUTES=30
SERVENEST_SYNC_TERMINAL_ACTIVATION_TTL_MINUTES=10
SERVENEST_SYNC_CREDENTIAL_VERSION=1
SERVENEST_SYNC_CLOCK_SKEW_SECONDS=300
SERVENEST_SYNC_REPLAY_NONCE_TTL_SECONDS=900
SERVENEST_SYNC_MAX_ATTEMPTS=20
SERVENEST_SYNC_RETRY_BACKOFF_SECONDS=5,15,30,60,300
SERVENEST_SYNC_CHANGES_STREAM=changes

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SIMBISA_API_BASE=https://data-api.simbisa.gaapunity.app
SIMBISA_API_KEY=
